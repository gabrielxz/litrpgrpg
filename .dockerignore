# The image needs the app workspace, the rules data, and the book's chapters (rules questions
# read them); the repository is mostly book art and builds, so everything else stays out of the
# build context.
*
!app/package.json
!app/pnpm-lock.yaml
!app/pnpm-workspace.yaml
!app/tsconfig.base.json
!app/packages
!rules
!book/[0-9][0-9]-*.md
app/packages/*/node_modules
app/packages/*/test
app/packages/web/dist
