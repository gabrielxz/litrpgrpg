# The image needs only the app workspace and the rules data; the repository is mostly book
# art and builds, so everything else stays out of the build context.
*
!app/package.json
!app/pnpm-lock.yaml
!app/pnpm-workspace.yaml
!app/tsconfig.base.json
!app/packages
!rules
app/packages/*/node_modules
app/packages/*/test
app/packages/web/dist
