# The image needs the app workspace, the rules data, the book's chapters (rules questions
# read them), and the packs' WebP images; the repository is mostly book art and builds, so
# everything else stays out of the build context.
*
!app/package.json
!app/pnpm-lock.yaml
!app/pnpm-workspace.yaml
!app/tsconfig.base.json
!app/packages
!rules
!book/[0-9][0-9]-*.md
!app/packs/images
app/packs/images/**/*.png
app/packs/images/*.py
app/packages/*/node_modules
app/packages/*/test
app/packages/web/dist
